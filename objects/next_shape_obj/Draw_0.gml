var shapes = [
    // Square shape
    [
        [[0, 0], [25, 0], [0, 25], [25, 25]],  
        [[0, 0], [25, 0], [0, 25], [25, 25]],  
        [[0, 0], [25, 0], [0, 25], [25, 25]], 
        [[0, 0], [25, 0], [0, 25], [25, 25]] 
    ],
    
    // Line shape
    [
        [[0, 0], [-25, 0], [-50, 0], [25, 0]],
        [[0, 0], [0, -25], [0, -50], [0, 25]], 
        [[0, 0], [-25, 0], [-50, 0], [25, 0]],  
        [[0, 0], [0, -25], [0, -50], [0, 25]]  
    ],
    
    // T-shape
    [
        [[0, -25], [-25, 0], [0, 0], [25, 0]],  
        [[0, 0], [0, -25], [0, 25], [25, 0]],     
        [[0, 25], [-25, 0], [0, 0], [25, 0]],     
        [[0, 0], [-25, 0], [0, -25], [0, 25]]   
    ],
    
    // L-shape
    [
        [[-25, 0], [0, 0], [25, 0], [25, -25]], 
        [[0, -25], [0, 0], [0, 25], [25, 25]],  
        [[-25, 0], [0, 0], [25, 0], [-25, 25]], 
        [[0, -25], [0, 0], [0, 25], [-25, -25]]   
    ],
    
    // Reverse L-shape
    [
        [[25, 0], [0, 0], [-25, 0], [-25, -25]], 
        [[0, -25], [0, 0], [0, 25], [-25, 25]],  
        [[25, 0], [0, 0], [-25, 0], [25, 25]],  
        [[0, -25], [0, 0], [0, 25], [25, -25]]   
    ],
    
    // Z-shape
    [
        [[-25, 0], [0, 0], [0, 25], [25, 25]],   
        [[0, 25], [0, 0], [25, 0], [25, -25]],    
        [[-25, 0], [0, 0], [0, 25], [25, 25]],   
        [[0, 25], [0, 0], [25, 0], [25, -25]]   
 
    ],
    
    // Reverse Z-shape
    [
        [[25, 0], [0, 0], [0, 25], [-25, 25]],   
        [[0, 25], [0, 0], [-25, 0], [-25, -25]],  
        [[25, 0], [0, 0], [0, 25], [-25, 25]],  
        [[0, 25], [0, 0], [-25, 0], [-25, -25]] 
    ]
];

selected_shape = global.next_shape;
rotation_positions = shapes[selected_shape];
block_color = selected_shape + 1;

var pos = rotation_positions[0];   // always show rotation 0 for preview

for (var i = 0; i < 4; i++) {
    var xx = x + pos[i][0];
    var yy = y + pos[i][1];

    draw_sprite(block_spr, block_color, xx, yy);
}